# Copy to .env and fill in real values. Never commit the real .env file.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://soul_care:soul_care_dev_password@db:5432/soul_care

# --- Redis / Celery broker ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET_KEY=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Third-party (all require signed BAAs before real PHI flows through them) ---
STRIPE_SECRET_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SENDGRID_API_KEY=

# --- KMS (encryption-at-rest for PHI fields; see docs/SECURITY_GRC_BLUEPRINT.md) ---
KMS_KEY_ID=
